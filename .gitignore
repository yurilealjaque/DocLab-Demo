
# ==========================================
# DOCLAB - GITIGNORE
# Python 3.13 + PySide6
# Version 1.0.0
# ==========================================

# 1. Entornos virtuales
.venv/
venv/
env/
ENV/

# 2. Cache y temporales Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.tox/
.nox/

# 3. Compilacion y distribucion
build/
dist/
*.egg-info/
.eggs/
*.egg
*.whl

# 4. PyInstaller
# Ignorar archivos spec experimentales.
*.spec

# Conservar la configuracion oficial.
!DocLab.spec

# 5. Configuracion local de editores
.vscode/
.idea/
*.swp
*.swo

# 6. Logs y archivos temporales
*.log
*.tmp
*.temp
*.bak
*~
.DS_Store
Thumbs.db
desktop.ini

# 7. Variables de entorno y credenciales
.env
.env.*
!.env.example
*.pem
*.key

# 8. Bases de datos locales
*.db
*.sqlite
*.sqlite3

# 9. Archivos privados de prueba
data/private/
data/temp/
data/output/
manual_tests/
pruebas_manuales/

# 10. Resultados generados
output/
exports/
temp/
*.docx.bak
*.docx.tmp

# 11. Cobertura de pruebas
.coverage
.coverage.*
htmlcov/
coverage.xml

# 12. Archivos temporales Qt
*.autosave
*.qmlc
*.jsc

# ==========================================
# 13. Recursos OCR
# ==========================================

# Modelos grandes descargados localmente.
src/doclab/resources/tessdata/*.traineddata

# Conservar la carpeta en Git.
!src/doclab/resources/tessdata/.gitkeep

# ==========================================
# 14. Recursos graficos
# ==========================================

# Los iconos y estilos de DocLab
# deben incluirse en el repositorio.
# No ignorar:
# src/doclab/resources/icons/doclab.ico
# src/doclab/ui/styles/theme.qss

# ==========================================
# FIN
# ==========================================
